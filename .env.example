# GeoModelingPlatform 环境变量示例（复制为 .env 或直接设置进程环境；.env 不提交 Git）

# ---- v0.4 通用建模平台 ----
# SQLite 与全部运行时工件根目录（默认 var/geomodeling，已 gitignore）
GEOMODELING_DATA_DIR=var/geomodeling

# ---- 前端托管 ----
# FastAPI 静态托管的前端构建产物（存在 index.html 才挂载）
GEOMODELING_FRONTEND_DIST=web/dist

# ---- v0.3.1 内置电阻率案例 ----
# 平台配置与指标产物（默认自动探测 outputs/ 下候选路径）
GEOMODELING_CONFIG=config/default.yaml
# GEOMODELING_METRICS_JSON=outputs/release_verify/metrics/metric_summaries.json
# 浏览器回执等证据落盘目录
GEOMODELING_EVIDENCE_DIR=outputs/api_evidence
# iDesktopX 体元缓存本地目录（仅诊断；瓦片一律经 iServer REST 获取）
GEOMODELING_VOXEL_CACHE_DIR=../Project/cache/RHO_KRIG_FINAL_20M_40_VOL_S3M2

# ---- iServer（凭据只走环境变量，绝不提交） ----
GEOMODELING_ISERVER_URL=http://localhost:8090/iserver
GEOMODELING_ISERVER_ADMIN_USER=
GEOMODELING_ISERVER_ADMIN_PASSWORD=
